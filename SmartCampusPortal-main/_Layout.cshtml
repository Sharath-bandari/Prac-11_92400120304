<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Smart Campus Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark campus-nav">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">SmartCampus</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <div class="navbar-nav ms-auto align-items-lg-center">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                @if (Context.Session.GetString("UserRole") == "Student") {
                    <a class="nav-link" asp-controller="Student" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-controller="Student" asp-action="CreateRequest">New Request</a>
                    <a class="nav-link" asp-controller="Student" asp-action="MyRequests">My Requests</a>
                    <a class="nav-link" asp-controller="Student" asp-action="Notices">Notices</a>
                }
                @if (Context.Session.GetString("UserRole") == "Admin") {
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="CreateNotice">Post Notice</a>
                }
                @if (Context.Session.GetInt32("UserId") != null) {
                    <span class="navbar-text text-white-50 mx-lg-2">Hi, @Context.Session.GetString("UserName")</span>
                    <a class="btn btn-light btn-sm ms-lg-2" asp-controller="Account" asp-action="Logout">Logout</a>
                } else {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-light btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @RenderBody()
</main>
<footer class="text-center py-4 text-secondary">© @DateTime.Now.Year Smart Campus Service Portal</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
